DOMAIN=matematika-urok.ru

POSTGRES_DB=mathsite
POSTGRES_USER=mathsite
POSTGRES_PASSWORD=   # openssl rand -base64 32

YC_FOLDER_ID=
YC_API_KEY=
YC_API_KEY_ID=

# Подпись JWT учителя. Без него backend не поднимется.
# Сгенерировать: openssl rand -base64 48
# Поменяешь — все текущие сессии админки разлогинятся.
JWT_SECRET=

# Нужен только если фронт открывают с другого origin, чем API.
# На проде фронт и API за одним nginx — можно оставить пустым.
CORS_ORIGINS=

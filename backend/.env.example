# Yandex Cloud — создай сервисный аккаунт и API-ключ в console.yandex.cloud
YC_FOLDER_ID=
YC_API_KEY_ID=
YC_API_KEY=

YC_MODEL_CHAT=yandexgpt/latest
YC_MODEL_EMBED_DOC=text-search-doc/latest
YC_MODEL_EMBED_QUERY=text-search-query/latest

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mathsite
POSTGRES_USER=mathsite
POSTGRES_PASSWORD=mathsite_dev_pw

APP_ENV=dev
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# JWT для админки учителя — ОБЯЗАТЕЛЬНО смени в проде
JWT_SECRET=change-me-to-a-random-32-byte-hex
JWT_TTL_HOURS=168

# куда класть загруженные через админку PDF (учебники/материалы)
UPLOAD_DIR=./uploads
